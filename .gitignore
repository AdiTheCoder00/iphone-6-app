__pycache__/
*.py[cod]
venv/
.venv/
backend/data/
.env
firmware/wake_esp32s3/config.h
*.log
.DS_Store
Thumbs.db

# Runtime state written by start-servers.ps1 (scheme/port the last run chose).
.backend-scheme
.frontend-port
.frontend-ca-port

# Tooling config: the shared files (.claude/launch.json, .impeccable/config.json)
# describe the project and are committed. The *.local.json ones hold this
# machine's own permission grants and consent flags, and the hook caches are
# regenerated on demand — none of that belongs to anyone else.
.claude/settings.local.json
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json

# Dashboard (React/Vite): dependencies and build output are both reproducible
# from package.json + `npm run build`, so neither belongs in the repo.
node_modules/
dashboard/dist/

# TLS material for the local HTTPS server. NEVER commit these.
# A previous commit published the CA private key to a public repo; because the
# CA is installed as a trusted root on the phone, that key could mint a
# trusted certificate for ANY domain, not just this project. History was
# rewritten to remove it and the CA regenerated. Regenerate locally instead —
# see README.
certs/
*.key
*.pem