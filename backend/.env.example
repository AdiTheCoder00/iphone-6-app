# Copy to backend/.env and adjust. Every value here is the built-in default,
# so an absent .env runs without an LLM (until GROQ_API_KEY is set).

# --- LLM (Groq) --------------------------------------------------------------
# Cloud LLM via Groq's OpenAI-compatible API. Get a key at
# https://console.groq.com/keys. Without it, /chat answers 503 and the
# frontend shows its "sad" fallback.
GROQ_API_KEY=
# Chat model. qwen3.6-27b is the one model on Groq's current catalog that
# supports both native tool calling and image input (it is also the vision
# default below). Reasoning is disabled per-request, so replies stay short
# and fast instead of burning tokens on internal thinking.
GROQ_CHAT_MODEL=qwen/qwen3.6-27b
# Vision model for photo descriptions (POST /vision). Same model as chat —
# the only multimodal option on the current catalog.
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- Generation --------------------------------------------------------------
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.7
LLM_REQUEST_TIMEOUT=60

# --- Speech-to-text (tap-to-talk) --------------------------------------------
# Weights download on first use into the HuggingFace cache (~140MB for base).
# "base" on CPU/int8 transcribes a 3s command in ~0.4s. Use "small"/"medium",
# or WHISPER_DEVICE=cuda with WHISPER_COMPUTE_TYPE=float16, for more accuracy.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Blank = autodetect, which is slow and unreliable on a 3-second clip.
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1
MAX_AUDIO_MB=10
# Ceiling on an uploaded image, separately from MAX_AUDIO_MB.
MAX_IMAGE_MB=10

# --- Text-to-speech ----------------------------------------------------------
# kokoro-onnx, local CPU. Model files (~350MB) download into TTS_MODEL_DIR on
# first use if absent.
TTS_ENABLED=true
TTS_MODEL_DIR=data/tts
# af_* / am_* American, bf_* / bm_* British. am_michael is warm and male.
TTS_VOICE=am_michael
TTS_SPEED=1.0
# Where the voice plays: "phone" (the phone's speaker, default) or "pc" (the
# PC's default output device — e.g. an Echo in Bluetooth speaker mode). With
# "pc" the phone mutes itself and the backend plays every clip locally.
SPEAKER=phone

# --- Persistence -------------------------------------------------------------
# One SQLite file for reminders and conversation history. Delete it to reset.
DB_PATH=data/companion.db
HISTORY_REPLAY_LIMIT=20
# How many stored messages the /conversation replay and the model context may
# use. A long tail costs prompt tokens on every reply.
CONVERSATION_STORE_LIMIT=500

# --- Proactive presence ------------------------------------------------------
# The companion speaking first. Never fires with no SSE client connected, never
# during quiet hours, and never twice inside one trigger's window.
PROACTIVE_ENABLED=true
PROACTIVE_MORNING_HOUR=8
# Wraps midnight when start > end.
PROACTIVE_QUIET_START=22
PROACTIVE_QUIET_END=7
# Hours before a stretch nudge / idle check-in. 0 disables either.
PROACTIVE_SESSION_HOURS=3
PROACTIVE_IDLE_HOURS=4
# City for the server-side morning briefing's weather line (e.g.
# "Gorakhpur, Uttar Pradesh"). Ambiguous Indian names need the state suffix —
# there are several Gorakhpurs and Open-Meteo's population ranking is wrong.
# The idle screen's weather stays per-device in the phone's settings. Empty
# means the briefing skips weather.
WEATHER_CITY=
# Reply language: "en" or "hi". Picks the LLM prompt language, the Kokoro
# TTS voice/lang pair, and pairs with WHISPER_LANGUAGE for recognition.
LANGUAGE=en
# Rain alert: once a day when today's forecast precipitation probability hits
# this percent. 0 disables.
RAIN_ALERT_THRESHOLD=60
# Battery-low push (laptops only; desktops have no battery). 0 disables.
BATTERY_ALERT_THRESHOLD=20
BATTERY_ALERT_INTERVAL_HOURS=4

# --- PC control --------------------------------------------------------------
# Media transport, volume and lock screen on the machine running this backend.
# Windows only — the tools do not register on other platforms regardless.
# A fixed whitelist of named actions; there is no arbitrary command execution.
PC_CONTROL_ENABLED=true

# Named shortcuts for open_in_browser, so "open my email" works. Any http/https
# address opens without being listed here — this is convenience, not a security
# boundary (that is the scheme check in services/pc_control.py).
# "dashboard" is served by serve_frontend.py at /dashboard/ — requires
# `npm run build` in dashboard/ first (the built files are gitignored).
# NOTE for the phone: localhost there is the phone itself. Use
# http://<computer-LAN-IP>:8080/dashboard/, or https://<computer-LAN-IP>:8443
# when certs exist — and then the backend URL in the phone's settings must
# also be https://<computer-LAN-IP>:8000 (mixed content is blocked on iOS).
PC_URL_SHORTCUTS={"email": "https://mail.google.com", "youtube": "https://youtube.com", "dashboard": "https://<computer-LAN-IP>:8443/dashboard/"}
# Sleep/shutdown tool. The model must ask first and then call again with
# confirm=true, but the confirmation is model-side only — anyone able to reach
# /chat could in principle skip it, so do not enable without COMPANION_TOKEN.
PC_POWER_CONTROL_ENABLED=true
# Seconds between "shutting down now" and the actual power off, so the user
# has time to hit cancel_shutdown.
PC_SHUTDOWN_DELAY_SECONDS=10
# Fixed app whitelist for launch_app. Keys are the spoken names the model may
# use; values are the executables to start. Add your own here — "notepad" is
# just a harmless default so the tool has something to test against.
PC_APP_WHITELIST={"notepad": "notepad.exe", "calculator": "calc.exe"}

# --- Smart home ---------------------------------------------------------------
# Which backend to use:
#   kasa            talk to TP-Link Kasa/Tapo directly on the LAN. Nothing
#                   extra to run, but TP-Link only.
#   home_assistant  go through Home Assistant — covers nearly every brand,
#                   but HA has to be running somewhere (on Windows that
#                   means Docker or a VM; it has no native Windows build).
#   none            smart home tools do not register at all.
SMART_HOME_PROVIDER=none

# --- ...if using "kasa" -------------------------------------------------------
# Your TP-Link ACCOUNT email and password. Newer Kasa firmware and all Tapo
# devices need these for the KLAP handshake — they derive the LOCAL auth,
# control never leaves your network. Older Kasa devices ignore them.
# These are real account credentials in a plaintext file; .env is gitignored
# and must stay that way.
TPLINK_USERNAME=
TPLINK_PASSWORD=

# --- ...if using "home_assistant" ---------------------------------------------
HA_ENABLED=false
HA_BASE_URL=http://localhost:8123
# Profile -> Security -> Long-Lived Access Tokens, inside Home Assistant.
# This authenticates FROM this backend TO Home Assistant — not the same
# secret as COMPANION_TOKEN, which is the reverse direction.
HA_TOKEN=
# Per-request ceiling for HA calls; it must answer fast or the companion is
# better off saying it could not.
HA_REQUEST_TIMEOUT=8.0

# --- Auth --------------------------------------------------------------------
# Shared secret required by every endpoint except /health. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# Set this. With PC control enabled, an empty token means anyone who can reach
# this port can lock your screen — and, with PC_POWER_CONTROL_ENABLED, could
# prompt the model into a shutdown. The server logs a warning at startup if
# unset. The same value goes in the phone's settings sheet and in
# firmware/wake_esp32s3/config.h (never committed — the file is gitignored).
COMPANION_TOKEN=

# --- FastAPI -----------------------------------------------------------------
# Local dev default is wide open. Narrow to explicit origins before exposing
# this API beyond localhost.
#
# NOTE: the ESP32 posts to /wake from another machine on the LAN, so run
# uvicorn with --host 0.0.0.0 (not 127.0.0.1) for that layer to work.
CORS_ORIGINS=["*"]
