# Copy to backend/.env and adjust. Every value here is the built-in default,
# so an absent .env runs against a stock local Ollama.

# --- Ollama ------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Any chat model you have pulled. qwen3:8b matches guru-rag-app; a smaller
# model (llama3.2:3b, qwen3:4b) is noticeably snappier for one-line replies.
OLLAMA_MODEL=qwen3:8b

# --- Generation --------------------------------------------------------------
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.7
LLM_REQUEST_TIMEOUT=60
# How long Ollama keeps the weights resident. The 5-minute default means a
# device used in short bursts pays a ~12s cold load nearly every time.
OLLAMA_KEEP_ALIVE=30m
# Load the model at startup instead of on the first thing the user says.
LLM_PREWARM_ENABLED=true
LLM_PREWARM_TIMEOUT=45
# Suppress <think> blocks on reasoning models (qwen3). Set false if your model
# has no thinking mode and the flag confuses your Ollama build.
LLM_DISABLE_THINKING=true

# --- Speech-to-text (tap-to-talk) --------------------------------------------
# Weights download on first use into the HuggingFace cache (~140MB for base).
# "base" on CPU/int8 transcribes a 3s command in ~0.4s. Use "small"/"medium",
# or WHISPER_DEVICE=cuda with WHISPER_COMPUTE_TYPE=float16, for more accuracy.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Blank = autodetect, which is slow and unreliable on a 3-second clip.
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1
MAX_AUDIO_MB=10

# --- Text-to-speech ----------------------------------------------------------
# kokoro-onnx, local CPU. Model files (~350MB) download into TTS_MODEL_DIR on
# first use if absent.
TTS_ENABLED=true
TTS_MODEL_DIR=data/tts
# af_* / am_* American, bf_* / bm_* British. af_heart is warm and female.
TTS_VOICE=af_heart
TTS_SPEED=1.0

# --- Persistence -------------------------------------------------------------
# One SQLite file for reminders and conversation history. Delete it to reset.
DB_PATH=data/companion.db
HISTORY_REPLAY_LIMIT=20

# --- Proactive presence ------------------------------------------------------
# The companion speaking first. Never fires with no SSE client connected, never
# during quiet hours, and never twice inside one trigger's window.
PROACTIVE_ENABLED=true
PROACTIVE_MORNING_HOUR=8
# Wraps midnight when start > end.
PROACTIVE_QUIET_START=22
PROACTIVE_QUIET_END=7
# Hours before a stretch nudge / idle check-in. 0 disables either.
PROACTIVE_SESSION_HOURS=3
PROACTIVE_IDLE_HOURS=4

# --- PC control --------------------------------------------------------------
# Media transport, volume and lock screen on the machine running this backend.
# Windows only — the tools do not register on other platforms regardless.
# A fixed whitelist of named actions; there is no arbitrary command execution.
PC_CONTROL_ENABLED=true

# --- Smart home (Home Assistant) ----------------------------------------------
# This backend never talks to a device brand directly — only to Home
# Assistant's REST API. HA itself speaks local network to TP-Link Kasa/Tapo
# (once its TP-Link integration is added) with no cloud round-trip.
HA_ENABLED=false
HA_BASE_URL=http://localhost:8123
# Profile -> Security -> Long-Lived Access Tokens, inside Home Assistant.
# This authenticates FROM this backend TO Home Assistant — not the same
# secret as COMPANION_TOKEN, which is the reverse direction.
HA_TOKEN=

# --- Auth --------------------------------------------------------------------
# Shared secret required by every endpoint except /health. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# Set this. With PC control enabled, an empty token means anyone who can reach
# this port can lock your screen. The server logs a warning at startup if unset.
# The same value goes in the phone's settings sheet and in the ESP32 firmware.
COMPANION_TOKEN=

# --- FastAPI -----------------------------------------------------------------
# Local dev default is wide open. Narrow to explicit origins before exposing
# this API beyond localhost.
#
# NOTE: the ESP32 posts to /wake from another machine on the LAN, so run
# uvicorn with --host 0.0.0.0 (not 127.0.0.1) for that layer to work.
CORS_ORIGINS=["*"]
